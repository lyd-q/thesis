***************************************************
	*** Merge BDS outcomes with grants
***************************************************

import delimited "`path'/Data/NIH_v3/nih_use.csv", clear
save "`path'/Data/NIH_v3/nih_use.dta", replace

import delimited "`path'/Raw_data/BDS/bds2023_msa.csv", clear
