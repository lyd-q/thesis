***************************************************************
	*** Adjust for inflation on the individual grants
***************************************************************
use "`path'/Data/NIH_v3/nih_cbsa_msa.dta", clear
merge m:1 year using "`path'/Data/Working/cpi_annual_avg.dta"
keep if _m == 3
drop _m
save "`path'/Data/NIH_v3/nih_cbsa_msa.dta", replace

use "`path'/Data/NIH_v3/nih_cbsa_msa.dta", clear
gen cpi_2000 = cpi if year == 2000
egen base_cpi = max(cpi_2000)
drop cpi_2000

rename FUNDING funding_real
drop if funding_real == .
gen funding_adj = (base_cpi / cpi) * funding_real
drop base_cpi cpi
save "`path'/Data/NIH_v3/nih_cbsa_msa.dta", replace

***************************************************
	*** Merge fields and district with NIH Grants
***************************************************

* Merge Department (Science Field)
use "`path'/Data/NIH_v3/nih_cbsa_msa.dta", clear
merge m:1 PROJECTNUMBER using "`path'/Data/NIH_v2/nih_departments.dta"
keep if _m != 2
drop _m
save "`path'/Data/NIH_v3/nih_cbsa_msa.dta", replace
// count if org_dept == "" --> 450,367
// count if org_dept == "NONE" -->  59,230


* Merge Dun and Bradstreet number
use "`path'/Data/NIH_v3/nih_cbsa_msa.dta", clear
merge m:1 PROJECTNUMBER ORGANIZATIONNAME using "`path'/Data/NIH_v2/nih_DUN.dta"
keep if _m != 2
drop _m
save "`path'/Data/NIH_v3/nih_cbsa_msa.dta", replace
// count if org_duns == "" --> 397,175
 
 ******************************************************************************************************
	**** FILL-IN TO INCLUDE ALL MSAs 2/14/26
 ******************************************************************************************************
 * Do fillin on NIH (by year and CBSA)!!!! Before merging any other data into NIH
use "`path'/Data/NIH_v3/nih_cbsa_msa.dta", clear
collapse (sum) funding_real funding_adj, by(CBSA_code CBSA_title year)
save "`path'/Data/NIH_v3/nih_cbsa_msa_funding.dta", replace

* fillin
* merge with crosswalk to make sure no CBSAs were lost
use "`path'/Data/Crosswalks/Used/county_cbsa_xwalk_2009.dta", clear
keep CBSA_code CBSA_title
duplicates drop // 374 MSAs

* DROP PUERTO RICO
drop if CBSA_code == "49500" | CBSA_code == "49500" | CBSA_code == "49500" | CBSA_code == "49500" | CBSA_code == "49500" | CBSA_code == "49500" | CBSA_code == "49500" | CBSA_code == "49500" |

CBSA_code	CBSA_title
49500	Yauco, PR
10380	Aguadilla-Isabela-San Sebastián, PR
21940	Fajardo, PR
25020	Guayama, PR
32420	Mayagüez, PR
38660	Ponce, PR
41980	San Juan-Caguas-Guaynabo, PR
41900	San Germán-Cabo Rojo, PR


save "`path'/Data/Crosswalks/Used/cbsa_list.dta", replace

use "`path'/Data/NIH_v3/nih_cbsa_msa_funding.dta", clear
merge m:1 CBSA_code CBSA_title using "`path'/Data/Crosswalks/Used/cbsa_list.dta"
* 46 MSAs need to be filled in, and other MSA-year combos
drop _m CBSA_title
fillin CBSA_code year

drop if year == .
replace funding_real = 0 if funding_real == .
replace funding_adj = 0 if funding_adj == .
drop _fillin

* will merge CBSA_title back in because I don't know how to do fillin otherwise
merge m:1 CBSA_code using "`path'/Data/Crosswalks/Used/cbsa_list.dta"
drop _m
save "`path'/Data/NIH_v3/nih_cbsa_msa_funding.dta", replace

* now we can merge in field/mech shares, for MSA-years that will have them

 *** Adding population
use "`path'/Data/Census/population/population_msa.dta", clear
reshape long pop, i(CBSA_code CBSA_title) j(year)
// rename CBSA_code cbsa_code
// rename CBSA_title cbsa_title
// destring cbsa_code, replace
save "`path'/Data/Census/population/population_msa_long.dta", replace

use  "`path'/Data/NIH_v3/nih_cbsa_msa_funding.dta", clear
// use "`path'/Data/NIH_Outcomes/nih_outcomes.dta", clear
merge 1:1 CBSA_code CBSA_title year using "`path'/Data/Census/population/population_msa_long.dta"
keep if _m == 3
drop _m
save "`path'/Data/NIH_Outcomes/nih_msa_funding.dta", replace

* per capita funding
rename funding_adj funding
gen funding_pc = funding / pop
gen log_funding = log(funding + 1)
gen log_funding_pc = log(funding_pc + 1)
save "`path'/Data/NIH_v4/nih_funding_use.dta", replace




